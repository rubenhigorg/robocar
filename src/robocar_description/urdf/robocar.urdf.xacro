<?xml version="1.0"?>
<!--
  Robocar: modelo URDF (hito 0.3 del TFM).

  Convenciones (REP-103/REP-105): x adelante, y izquierda, z arriba.
  base_link en el CENTRO DEL EJE TRASERO (convención Ackermann: TEB y la
  odometría de modelo bicicleta se referencian ahí), a la altura del eje.
  base_footprint es su proyección en el suelo.

  v1: todas las juntas son fijas (suficiente para TF + visualización 3D).
  Las ruedas no rotan visualmente; se puede mejorar con joint_states después.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robocar">

  <!-- ══════════════════════════════════════════════════════════════════
       MEDIDAS DEL COCHE — ¡RELLENAR CON EL METRO! (unidades: metros)
       Valores actuales = típicos de un chasis RC 1/10, solo orientativos.
       ══════════════════════════════════════════════════════════════════ -->

  <!-- Batalla (L): 17.5 cm — fuente: memoria TFG2, modelo del sistema -->
  <xacro:property name="wheelbase"      value="0.175"/>
  <!-- Via (D): 14 cm — fuente: memoria TFG2, modelo del sistema -->
  <xacro:property name="track_width"    value="0.140"/>
  <!-- Ruedas de 6.5 cm de diametro — fuente: memoria TFG2 -->
  <xacro:property name="wheel_radius"   value="0.0325"/>
  <!-- Ancho de rueda: 2.6 cm (medido jul 2026) -->
  <xacro:property name="wheel_width"    value="0.026"/>
  <!-- Chasis (medido jul 2026): 35 cm largo x 17.5 cm ancho max x 13 cm de
       alto DESDE EL SUELO (la caja parte de la altura del eje: 13 - 3.25) -->
  <xacro:property name="chassis_length" value="0.350"/>
  <xacro:property name="chassis_width"  value="0.175"/>
  <xacro:property name="chassis_height" value="0.0975"/>
  <!-- Voladizo trasero: 8.5-9 cm (medido jul 2026) -->
  <xacro:property name="chassis_rear_overhang" value="0.085"/>

  <!-- Otros datos del modelo del TFG2 (utiles para Nav2/TEB, no para el URDF):
       angulo max de direccion ~45º -> radio de giro minimo = L/tan(45º) = 0.175 m
       velocidad operativa probada = 0.18 m/s -->

  <!-- Placeholders de sensores reescalados al tamano real del chasis -->

  <!-- Sensores: posicion respecto a base_link (centro eje trasero).
       x adelante, y izquierda, z arriba desde la altura del eje. -->
  <!-- TODO(medir): RPLidar C1 (donde se vaya a montar; z = altura del plano
       de barrido sobre el eje). Si el conector USB queda hacia atras, dejar
       yaw=0; si no, ajustar la rotacion. -->
  <!-- LIDAR (medido jul 2026): 7cm del eje trasero, plano de barrido a 6cm
       del suelo (rel. eje: 6 - 3.25). Posible oclusion SOLO en el sector
       trasero (radiador de la RPi sobre el eje): verificar con /scan en
       Foxglove y filtrar sector o elevar el LIDAR si molesta. -->
  <xacro:property name="laser_x"   value="0.070"/>
  <xacro:property name="laser_z"   value="0.0275"/>
  <!-- IMU (confirmado jul 2026): 21-22cm del eje trasero, chip a 10cm del
       suelo, centrado. -->
  <xacro:property name="imu_x"     value="0.210"/>
  <xacro:property name="imu_z"     value="0.0675"/>
  <!-- Camara: DESMONTADA (jul 2026, mastil retirado). Reactivar con el flag
       si vuelve el lane-following. -->
  <xacro:property name="camera_mounted" value="false"/>
  <xacro:property name="camera_x"  value="0.200"/>
  <xacro:property name="camera_z"  value="0.070"/>
  <!-- Ultrasonidos (confirmados jul 2026, medidos desde el eje trasero):
       central a 25cm, laterales 1cm retranqueados (24cm) y a 3.5cm del
       borde -> y=+-5.25cm. Altura 7cm del suelo (rel. eje: 7 - 3.25). -->
  <xacro:property name="us_x"      value="0.250"/>
  <xacro:property name="us_side_x" value="0.240"/>
  <xacro:property name="us_y"      value="0.0525"/>
  <xacro:property name="us_z"      value="0.0375"/>

  <!-- ══════════════ materiales (colores en Foxglove/RViz) ══════════════ -->
  <material name="body_grey"><color rgba="0.35 0.38 0.42 1"/></material>
  <material name="wheel_black"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="sensor_blue"><color rgba="0.20 0.45 0.85 1"/></material>
  <material name="lidar_red"><color rgba="0.80 0.20 0.20 1"/></material>

  <!-- ══════════════ macro de rueda ══════════════ -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin rpy="${pi/2} 0 0"/>
        <material name="wheel_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0"/>
    </joint>
  </xacro:macro>

  <!-- ══════════════ estructura ══════════════ -->

  <!-- proyección en el suelo (la usa Nav2) -->
  <link name="base_footprint"/>

  <!-- centro del eje trasero, a la altura del eje -->
  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <!-- la caja del chasis se centra respecto a la batalla -->
      <origin xyz="${chassis_length/2 - chassis_rear_overhang} 0 ${chassis_height/2}"/>
      <material name="body_grey"/>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}"/>
  </joint>

  <!-- ruedas -->
  <xacro:wheel name="rear_left_wheel"   x="0"            y="${track_width/2}"/>
  <xacro:wheel name="rear_right_wheel"  x="0"            y="${-track_width/2}"/>
  <xacro:wheel name="front_left_wheel"  x="${wheelbase}" y="${track_width/2}"/>
  <xacro:wheel name="front_right_wheel" x="${wheelbase}" y="${-track_width/2}"/>

  <!-- LIDAR: frame "laser" (el que publica rplidar_ros en /scan) -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_red"/>
    </visual>
  </link>
  <!-- El 0 grados del RPLidar C1 apunta HACIA ATRAS con el montaje actual
       (flecha del sensor hacia las ruedas delanteras) -> giro de 180 en yaw.
       Verificado empiricamente contra los ultrasonidos (jul 2026). -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${laser_x} 0 ${laser_z}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- IMU: frame "imu_link" (usarlo en accelerometer_node, hito 0.5) -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.015 0.003"/></geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} 0 ${imu_z}"/>
  </joint>

  <!-- Cámara frontal (desmontada; se incluye solo si camera_mounted=true) -->
  <xacro:if value="${camera_mounted}">
    <link name="camera_link">
      <visual>
        <geometry><box size="0.025 0.06 0.025"/></geometry>
        <material name="sensor_blue"/>
      </visual>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${camera_x} 0 ${camera_z}"/>
    </joint>
  </xacro:if>

  <!-- Ultrasonidos HC-SR04 (izq / centro / der). Los laterales miran hacia
       afuera ~25 grados (TODO confirmar angulo exacto). -->
  <xacro:property name="us_yaw" value="0.436"/>
  <xacro:macro name="ultrasound" params="name x y yaw">
    <link name="${name}">
      <visual>
        <geometry><box size="0.015 0.045 0.02"/></geometry>
        <material name="sensor_blue"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${us_z}" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>
  <xacro:ultrasound name="ultrasound_left"   x="${us_side_x}" y="${us_y}"  yaw="${us_yaw}"/>
  <xacro:ultrasound name="ultrasound_center" x="${us_x}"      y="0"        yaw="0"/>
  <xacro:ultrasound name="ultrasound_right"  x="${us_side_x}" y="${-us_y}" yaw="${-us_yaw}"/>

</robot>
